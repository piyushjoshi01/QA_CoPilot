# QA CoPilot — copy to `.env` and fill in (`.env` is gitignored).
#
#   cp .env.example .env
#
# Option A — load into your shell:
#   source scripts/load-env.sh
#   # or:  set -a && source .env && set +a
#
# Option B — run `java -jar ...` from anywhere: the JAR also searches upward from its own
# location (e.g. generation-engine/build/libs → repo root) for `.env`.
#
# Option C — explicit file path (works from any cwd):
#   export QA_COPILOT_DOTENV=/absolute/path/to/QA_CoPilot/QA_CoPilot/.env
#
# Or one-off:
#   export OPENAI_API_KEY="sk-..."

# Required for OpenAI scenario generation (--generator ai)
export OPENAI_API_KEY=

# Optional model (default used by the CLI if unset: gpt-4o-mini)
export OPENAI_MODEL=gpt-4o-mini

# Optional: Spring app under test (path you pass to --spring-project)
# export QACOPILOT_SPRING_PROJECT=/absolute/path/to/your-spring-boot-app

# Optional: generated test_framework output (path you pass to --output)
# export QACOPILOT_TEST_FRAMEWORK=/absolute/path/to/test_framework
